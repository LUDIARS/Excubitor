{
  "name": "@ludiars/excubitor",
  "version": "1.6.0",
  "private": true,
  "description": "LUDIARS service liveness, log aggregation, and error triage monitor server.",
  "type": "module",
  "bin": {
    "excubitorctl": "dist/local-control/cli.js"
  },
  "scripts": {
    "dev": "npm install --include=dev && npm run build && npm run start",
    "dev:safe": "npm install --include=dev && npm run build && npm run start:safe",
    "build": "tsc -p lib/lapilli/packages/log-weaver/tsconfig.json && tsc",
    "start": "node dist/server.js",
    "service": "node dist/service-runner.js",
    "ctl": "node dist/local-control/cli.js",
    "mesh:legacy-monitor": "node dist/federation/security/legacy-monitor-cli.js",
    "agent-token": "node dist/secrets/agent-token-cli.js",
    "start:service": "node dist/server.js --service",
    "start:safe": "node dist/server.js --safe",
    "typecheck": "tsc --noEmit",
    "packages:audit": "tsx src/update/package-audit/cli.ts",
    "packages:audit:daily": "node dist/update/package-audit/cli.js --deliver --json",
    "ergo:watch": "tsx src/update/ergo-watch/cli.ts",
    "ergo:watch:job": "node dist/update/ergo-watch/cli.js --deliver --json",
    "release": "tsx src/release/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run --pool=forks",
    "smoke:runtime": "node scripts/runtime-smoke.mjs"
  },
  "dependencies": {
    "@ludiars/log-weaver": "file:lib/lapilli/packages/log-weaver",
    "@duckdb/node-api": "^1.5.4-r.1",
    "@hono/node-server": "^1.13.7",
    "@ludiars/one-shot": "file:lib/lapilli/packages/one-shot",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "js-yaml": "^4.1.0",
    "pino": "^9.5.0",
    "ssh2": "1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/ssh2": "1.15.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
